##gesture_recognizer code:
import math

class GestureRecognizer:
    def __init__(self):
        self.finger_tips = [4, 8, 12, 16, 20]

    def fingers_up(self, landmarks):
        fingers = []
        # Thumb (compare x for left/right)
        if landmarks[4][0] < landmarks[3][0]:
            fingers.append(1)
        else:
            fingers.append(0)
        # Other 4 fingers (compare y)
        for tip in [8, 12, 16, 20]:
            if landmarks[tip][1] < landmarks[tip - 2][1]:
                fingers.append(1)
            else:
                fingers.append(0)
        return fingers  # [thumb, index, middle, ring, pinky]

    def distance(self, p1, p2):
        return math.hypot(p1[0] - p2[0], p1[1] - p2[1])

    def recognize(self, landmarks):
        f = self.fingers_up(landmarks)
        total = sum(f)

        pinch_dist = self.distance(landmarks[4], landmarks[8])

        # --- Mode Switch Gestures ---
        if f == [0, 0, 0, 0, 0]:
            return "FIST"
        if f == [1, 1, 1, 1, 1]:
            return "OPEN_PALM"
        if f == [0, 1, 1, 0, 0]:
            return "PEACE"           # Media Control mode
        if f == [1, 1, 0, 0, 0]:
            return "THUMBS_INDEX"    # Appliance Control mode
        if f == [0, 1, 0, 0, 1]:
            return "SPIDERMAN"       # Emergency SOS

        # --- Virtual Mouse Gestures ---
        if f == [0, 1, 0, 0, 0]:
            return "POINTING"        # Move cursor
        if pinch_dist < 30:
            return "PINCH"           # Left click
        if f == [0, 1, 1, 0, 0] and self.distance(landmarks[8], landmarks[12]) < 30:
            return "TWO_PINCH"       # Right click

        # --- Media Gestures ---
        if f == [0, 0, 0, 0, 1]:
            return "PINKY"           # Next track
        if f == [1, 0, 0, 0, 0]:
            return "THUMB_ONLY"      # Prev track

        return "UNKNOWN"

##rock_papers_scissors code:
"""
Rock Paper Scissors  -  OpenCV only (no MediaPipe)
Gesture logic (pure finger count):
  0 fingers  ->  Rock     (closed fist)
  2 fingers  ->  Scissors (index + middle up)
  4-5 fingers -> Paper    (open palm)
Tubelight / fluorescent lighting optimised.
"""

import cv2
import numpy as np
import random
import time
from collections import Counter


# ─── Tubelight-optimised enhancement ────────────────────────────────────────
def enhance_frame(frame):
    """
    Bilateral filter  -> removes flicker noise, keeps hand edges sharp
    CLAHE on L channel -> local contrast boost for flat fluorescent light
    Sharpen kernel     -> restores edges for clean contour detection
    """
    smooth = cv2.bilateralFilter(frame, d=9, sigmaColor=75, sigmaSpace=75)

    lab = cv2.cvtColor(smooth, cv2.COLOR_BGR2LAB)
    l, a, b = cv2.split(lab)
    clahe = cv2.createCLAHE(clipLimit=2.5, tileGridSize=(8, 8))
    l = clahe.apply(l)
    enhanced = cv2.merge([l, a, b])
    enhanced = cv2.cvtColor(enhanced, cv2.COLOR_LAB2BGR)

    kernel = np.array([[ 0, -1,  0],
                       [-1,  5, -1],
                       [ 0, -1,  0]], dtype=np.float32)
    return cv2.filter2D(enhanced, -1, kernel)


# ─── Skin mask (YCrCb + HSV) ─────────────────────────────────────────────────
def skin_mask(frame):
    ycrcb = cv2.cvtColor(frame, cv2.COLOR_BGR2YCrCb)
    mask_y = cv2.inRange(ycrcb,
                         np.array([0,  133,  77], dtype=np.uint8),
                         np.array([255, 173, 127], dtype=np.uint8))

    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
    mask_h1 = cv2.inRange(hsv,
                          np.array([0,  20,  60], dtype=np.uint8),
                          np.array([25, 255, 255], dtype=np.uint8))
    mask_h2 = cv2.inRange(hsv,
                          np.array([170, 20, 60], dtype=np.uint8),
                          np.array([180, 255, 255], dtype=np.uint8))

    mask = cv2.bitwise_or(mask_y, cv2.bitwise_or(mask_h1, mask_h2))

    k_open  = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
    k_close = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (11, 11))
    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN,  k_open,  iterations=2)
    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, k_close, iterations=3)
    mask = cv2.GaussianBlur(mask, (5, 5), 0)
    _, mask = cv2.threshold(mask, 127, 255, cv2.THRESH_BINARY)
    return mask


def largest_contour(mask, min_area=6000):
    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL,
                                   cv2.CHAIN_APPROX_SIMPLE)
    if not contours:
        return None
    cnt = max(contours, key=cv2.contourArea)
    return cnt if cv2.contourArea(cnt) > min_area else None


# ─── Finger counter (fixed) ──────────────────────────────────────────────────
def count_fingers(cnt):
    """
    Counts extended fingers using convexity defects.

    KEY FIX vs previous version:
      Old code always did  `fingers + 1`  so a fist returned 1 instead of 0.
      New logic:
        - 0 valid defects  ->  return 0  (fist / Rock)
        - N valid defects  ->  return N + 1  (valleys between fingers)

    Valley is valid when:
      angle  < 90 deg  (sharp V between fingers)
      depth  > 20 px   (deep enough to not be a knuckle bump)
    """
    hull_idx = cv2.convexHull(cnt, returnPoints=False)
    if hull_idx is None or len(hull_idx) < 3:
        return 0

    try:
        defects = cv2.convexityDefects(cnt, hull_idx)
    except cv2.error:
        return 0

    if defects is None:
        return 0   # no defects at all -> fist

    valid_defects = 0
    for i in range(defects.shape[0]):
        s, e, f, d = defects[i, 0]
        start = cnt[s][0]
        end   = cnt[e][0]
        far   = cnt[f][0]
        depth = d / 256.0

        a = np.linalg.norm(end   - start)
        b = np.linalg.norm(far   - start)
        c = np.linalg.norm(end   - far  )

        if b == 0 or c == 0:
            continue

        cos_a = np.clip((b**2 + c**2 - a**2) / (2 * b * c), -1, 1)
        angle = np.degrees(np.arccos(cos_a))

        if angle < 90 and depth > 20:
            valid_defects += 1

    # THE FIX: only add 1 when there are actual valid defects
    if valid_defects == 0:
        return 0                            # closed fist
    return min(valid_defects + 1, 5)        # valleys + 1 = finger count


# ─── Gesture classification (pure finger count) ──────────────────────────────
def classify(n_fingers):
    """
    0         ->  Rock
    2         ->  Scissors
    4 or 5    ->  Paper
    anything else -> None (ambiguous, smoothing buffer handles it)
    """
    if n_fingers == 0:
        return "Rock"
    if n_fingers == 2:
        return "Scissors"
    if n_fingers in (4, 5):
        return "Paper"
    return None


# ─── Game logic ──────────────────────────────────────────────────────────────
CHOICES = ["Rock", "Paper", "Scissors"]
BEATS   = {"Rock": "Scissors", "Paper": "Rock", "Scissors": "Paper"}

def get_result(player, cpu):
    if player == cpu:         return "Tie!"
    if BEATS[player] == cpu:  return "You Win!  :)"
    return                           "You Lose! :("


# ─── Drawing helpers ─────────────────────────────────────────────────────────
FONT = cv2.FONT_HERSHEY_DUPLEX

def shadow_text(img, text, pos, scale, color, thick=2):
    x, y = pos
    cv2.putText(img, text, (x+2, y+2), FONT, scale, (0,0,0), thick+1, cv2.LINE_AA)
    cv2.putText(img, text, (x,   y  ), FONT, scale, color,   thick,   cv2.LINE_AA)

def pill(img, x1, y1, x2, y2, color, alpha=0.60):
    ov = img.copy()
    cv2.rectangle(ov, (x1, y1), (x2, y2), color, -1, cv2.LINE_AA)
    cv2.addWeighted(ov, alpha, img, 1 - alpha, 0, img)


# ─── ROI (place hand inside the green box) ───────────────────────────────────
ROI_X1, ROI_Y1 = 80,  100
ROI_X2, ROI_Y2 = 520, 540


# ─── Main ────────────────────────────────────────────────────────────────────
def main():
    cap = cv2.VideoCapture(0)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH,  1280)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT,  720)

    scores          = {"You": 0, "CPU": 0, "Tie": 0}
    state           = "waiting"
    countdown_start = 0.0
    result_start    = 0.0
    COUNTDOWN       = 3
    RESULT_SHOW     = 2.5

    cpu_choice    = None
    player_choice = None
    result_text   = ""

    # Smoothing: majority vote over last 14 frames, need 60% agreement
    gesture_buf = []
    BUF  = 14
    CONF = 0.60

    show_mask  = False
    show_debug = True   # live finger count display; press D to toggle

    print("=" * 50)
    print("  Rock Paper Scissors  -  Pure Finger Count")
    print("  Gestures:")
    print("    Fist          ->  Rock")
    print("    2 fingers up  ->  Scissors")
    print("    Open palm     ->  Paper")
    print("  SPACE  -> start round")
    print("  D      -> toggle finger-count debug")
    print("  M      -> toggle skin mask view")
    print("  R      -> reset scores | Q -> quit")
    print("=" * 50)

    while True:
        ret, frame = cap.read()
        if not ret:
            break

        frame = cv2.flip(frame, 1)
        h, w  = frame.shape[:2]

        # Enhance and detect
        enhanced = enhance_frame(frame)
        roi      = enhanced[ROI_Y1:ROI_Y2, ROI_X1:ROI_X2]
        mask_roi = skin_mask(roi)
        cnt      = largest_contour(mask_roi)

        raw_gesture = None
        n_fing      = 0

        if cnt is not None:
            cnt_shifted = cnt + np.array([ROI_X1, ROI_Y1])
            cv2.drawContours(frame, [cnt_shifted], -1, (0, 255, 100), 2)
            hull_pts = cv2.convexHull(cnt_shifted)
            cv2.polylines(frame, [hull_pts], True, (255, 200, 0), 2)

            n_fing      = count_fingers(cnt)
            raw_gesture = classify(n_fing)

        # Skin mask debug overlay
        if show_mask:
            full_mask = np.zeros((h, w), dtype=np.uint8)
            full_mask[ROI_Y1:ROI_Y2, ROI_X1:ROI_X2] = mask_roi
            mc = cv2.cvtColor(full_mask, cv2.COLOR_GRAY2BGR)
            frame = cv2.addWeighted(frame, 0.6, mc, 0.4, 0)

        # Smoothing buffer
        if raw_gesture:
            gesture_buf.append(raw_gesture)
        if len(gesture_buf) > BUF:
            gesture_buf.pop(0)

        stable_gesture = None
        if gesture_buf:
            top, freq = Counter(gesture_buf).most_common(1)[0]
            if freq / len(gesture_buf) >= CONF:
                stable_gesture = top

        now = time.time()

        # ──────────────────── UI ─────────────────────────────────────────

        # ROI box
        roi_color = (0, 255, 100) if stable_gesture else (60, 140, 60)
        cv2.rectangle(frame, (ROI_X1, ROI_Y1), (ROI_X2, ROI_Y2),
                      roi_color, 2, cv2.LINE_AA)
        cv2.putText(frame, "Place hand here", (ROI_X1, ROI_Y1 - 10),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.55, roi_color, 1, cv2.LINE_AA)

        # Header bar
        pill(frame, 0, 0, w, 75, (15, 15, 15), 0.80)
        shadow_text(frame, "ROCK  PAPER  SCISSORS",
                    (w // 2 - 240, 52), 1.3, (255, 220, 50), 2)

        # Score bar
        pill(frame, 0, h - 55, w, h, (15, 15, 15), 0.80)
        shadow_text(frame,
            f"  You: {scores['You']}      Tie: {scores['Tie']}      CPU: {scores['CPU']}  ",
            (w // 2 - 230, h - 15), 0.85, (180, 255, 180), 2)

        # TL boost label
        cv2.putText(frame, "TL-BOOST ON", (w - 160, 65),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.50, (100, 255, 100), 1, cv2.LINE_AA)

        # Finger count debug badge
        if show_debug and cnt is not None:
            pill(frame, ROI_X2 + 10, ROI_Y1, ROI_X2 + 220, ROI_Y1 + 60,
                 (20, 20, 50), 0.80)
            shadow_text(frame, f"Fingers : {n_fing}",
                        (ROI_X2 + 18, ROI_Y1 + 36), 0.80, (200, 200, 255))

        # ── WAITING ──────────────────────────────────────────────────────
        if state == "waiting":
            if stable_gesture:
                pill(frame, ROI_X1, ROI_Y2 + 8, ROI_X2, ROI_Y2 + 52,
                     (0, 70, 0), 0.75)
                shadow_text(frame, f"Gesture: {stable_gesture}",
                            (ROI_X1 + 10, ROI_Y2 + 40), 0.85, (80, 255, 80))

            pill(frame, w//2-290, h//2-60, w//2+290, h//2+65, (20,20,20), 0.75)
            shadow_text(frame, "Show hand in box, then press SPACE",
                        (w//2-275, h//2-15), 0.80, (210, 210, 210))
            shadow_text(frame, "D = debug   M = mask   R = reset   Q = quit",
                        (w//2-265, h//2+42), 0.68, (150, 150, 150))

        # ── COUNTDOWN ────────────────────────────────────────────────────
        elif state == "countdown":
            elapsed   = now - countdown_start
            remaining = COUNTDOWN - elapsed

            if remaining <= 0:
                player_choice = stable_gesture or "Rock"
                cpu_choice    = random.choice(CHOICES)
                result_text   = get_result(player_choice, cpu_choice)

                if   "Win"  in result_text: scores["You"] += 1
                elif "Lose" in result_text: scores["CPU"] += 1
                else:                       scores["Tie"] += 1

                state        = "result"
                result_start = now
            else:
                shadow_text(frame, str(int(remaining) + 1),
                            (w//2-35, h//2+70), 5.5, (0, 220, 255), 6)
                shadow_text(frame, "Get Ready!",
                            (w//2-115, h//2-80), 1.4, (255, 220, 50))

                if stable_gesture:
                    pill(frame, ROI_X1, ROI_Y2+8, ROI_X2, ROI_Y2+52, (0,70,0), 0.75)
                    shadow_text(frame, f"Locked: {stable_gesture}",
                                (ROI_X1+10, ROI_Y2+40), 0.85, (80, 255, 80))
                else:
                    pill(frame, ROI_X1, ROI_Y2+8, ROI_X2, ROI_Y2+52, (70,0,0), 0.75)
                    shadow_text(frame, "No hand detected!",
                                (ROI_X1+10, ROI_Y2+40), 0.85, (100, 100, 255))

        # ── RESULT ───────────────────────────────────────────────────────
        elif state == "result":
            if   "Win"  in result_text: rc = (80, 255, 100)
            elif "Lose" in result_text: rc = (80, 100, 255)
            else:                       rc = (255, 220,  50)

            pill(frame, w//2-300, h//2-95, w//2+300, h//2+145, (20,20,20), 0.85)
            shadow_text(frame, result_text,           (w//2-190, h//2-35),  1.6, rc, 3)
            shadow_text(frame, f"You:  {player_choice}", (w//2-155, h//2+35), 1.0, (150,255,150))
            shadow_text(frame, f"CPU:  {cpu_choice}",    (w//2-155, h//2+90), 1.0, (150,150,255))
            shadow_text(frame, "SPACE to play again",    (w//2-155, h//2+132), 0.75, (180,180,180))

            if now - result_start >= RESULT_SHOW:
                state = "waiting"
                gesture_buf.clear()

        cv2.imshow("Rock Paper Scissors", frame)

        key = cv2.waitKey(1) & 0xFF
        if   key == ord('q'): break
        elif key == ord('r'):
            scores = {"You": 0, "CPU": 0, "Tie": 0}
            state  = "waiting"
            gesture_buf.clear()
        elif key == ord('m'): show_mask  = not show_mask
        elif key == ord('d'): show_debug = not show_debug
        elif key == ord(' '):
            if state == "waiting":
                state           = "countdown"
                countdown_start = now
                gesture_buf.clear()
            elif state == "result":
                state = "waiting"
                gesture_buf.clear()

    cap.release()
    cv2.destroyAllWindows()
    print("\nFinal Scores ->",
          f"You: {scores['You']}  |  Tie: {scores['Tie']}  |  CPU: {scores['CPU']}")


if __name__ == "__main__":
    main()

##main code:
import cv2
import mediapipe as mp
import numpy as np
import time
import random
import threading
from collections import Counter
from pynput.mouse import Button, Controller as MouseController
from pynput.keyboard import Key, Controller as KeyboardController
from gesture_recognizer import GestureRecognizer

try:
    import pyttsx3
    _tts_engine = pyttsx3.init()
    _tts_engine.setProperty("rate", 160)
    _TTS_AVAILABLE = True
except Exception:
    _TTS_AVAILABLE = False

_tts_lock = threading.Lock()

# ─── CONFIG ───────────────────────────────────────────────
SCREEN_W, SCREEN_H  = 1920, 1080
CAM_W, CAM_H        = 640, 480
SMOOTH              = 5
FRAME_REDUCTION     = 80
MENU_TRIGGER_HOLD   = 1.0    # hold THUMBS_INDEX 1s to open menu
MENU_SELECT_HOLD    = 0.6    # hold a gesture inside menu 0.6s to confirm

mouse    = MouseController()
keyboard = KeyboardController()

# ─── MODES ────────────────────────────────────────────────
MODES = {
    "MOUSE":     ("Virtual Mouse",            (255, 200,   0)),
    "MEDIA":     ("Media Control",            (  0, 200, 255)),
    "GAME":      ("Rock Paper Scissors Game", (200, 100, 255)),
    "APPLIANCE": ("Appliance Control",        (  0, 255, 100)),
    "SOS":       ("EMERGENCY SOS",            (  0,   0, 255)),
    "IDLE":      ("Idle",                     (180, 180, 180)),
    "MENU":      ("Mode Select",              (255, 165,   0)),
}

# ─── MENU OPTIONS ─────────────────────────────────────────
# (gesture_to_show, target_mode, hint_text)
# THUMBS_INDEX is reserved as the menu trigger — not listed here
MENU_OPTIONS = [
    ("OPEN_PALM",  "MOUSE",     "All 5 fingers open  "),
    ("PEACE",      "MEDIA",     "Index + Middle up   "),
    ("THUMB_ONLY", "APPLIANCE", "Only thumb up       "),
    ("FIST",       "GAME",      "All fingers closed  "),
    ("SPIDERMAN",  "SOS",       "Index + Pinky up    "),
    ("POINTING",   "IDLE",      "Only index finger up"),
]

# ─── MEDIAPIPE SETUP ──────────────────────────────────────
mp_hands = mp.solutions.hands
mp_draw  = mp.solutions.drawing_utils
hands    = mp_hands.Hands(
    static_image_mode=False,
    max_num_hands=1,
    min_detection_confidence=0.8,
    min_tracking_confidence=0.8
)

recognizer = GestureRecognizer()

# ─── STATE ────────────────────────────────────────────────
mode             = "IDLE"
smooth_x         = [0] * SMOOTH
smooth_y         = [0] * SMOOTH
click_cooldown   = 0
mode_cooldown    = 0
gesture_lock     = 0
sos_triggered    = False
appliance_states = {"LIGHT": False, "FAN": False}

# ─── MENU STATE ───────────────────────────────────────────
pre_menu_mode         = "IDLE"  # mode before menu opened
menu_select_candidate = None    # gesture being held inside menu
menu_select_start     = 0.0     # when that hold started
menu_no_hand_since    = 0.0     # tracks when hand disappeared in menu

# ─── MENU TRIGGER STATE ───────────────────────────────────
# THUMBS_INDEX held for MENU_TRIGGER_HOLD seconds opens the menu
trigger_hold_start = 0.0

# ─── RPS GAME STATE ───────────────────────────────────────
RPS_CHOICES = ["Rock", "Paper", "Scissors"]
RPS_BEATS   = {"Rock": "Scissors", "Paper": "Rock", "Scissors": "Paper"}

rps_state        = "waiting"
rps_countdown_st = 0.0
rps_result_st    = 0.0
RPS_COUNTDOWN    = 3
RPS_RESULT_SHOW  = 2.5

rps_cpu_choice    = None
rps_player_choice = None
rps_result_text   = ""
rps_scores        = {"You": 0, "CPU": 0, "Tie": 0}

rps_buf  = []
RPS_BUF  = 14
RPS_CONF = 0.60

RPS_GESTURE_MAP = {
    "FIST":      "Rock",
    "PEACE":     "Scissors",
    "OPEN_PALM": "Paper",
}

# ─── HELPERS ──────────────────────────────────────────────
def speak(text):
    if not _TTS_AVAILABLE:
        return
    def _run():
        with _tts_lock:
            try:
                _tts_engine.say(text)
                _tts_engine.runAndWait()
            except Exception:
                pass
    threading.Thread(target=_run, daemon=True).start()

def trigger_sos():
    global sos_triggered
    if not sos_triggered:
        sos_triggered = True
        speak("Emergency SOS triggered. Help is needed.")
        print("SOS TRIGGERED!")

def toggle_appliance(name):
    appliance_states[name] = not appliance_states[name]
    state = "ON" if appliance_states[name] else "OFF"
    speak(f"{name} turned {state}")
    print(f"{name}: {state}")

def get_landmarks(hand_landmarks, w, h):
    return [
        (int(lm.x * w), int(lm.y * h))
        for lm in hand_landmarks.landmark
    ]

def rps_get_result(player, cpu):
    if player == cpu:            return "Tie!  ="
    if RPS_BEATS[player] == cpu: return "You Win!  :)"
    return                               "You Lose! :("

# ─── MENU TRIGGER PROGRESS BAR ────────────────────────────
def draw_trigger_bar(frame, progress):
    """Small bar at bottom showing THUMBS_INDEX hold progress."""
    bar_w = int((CAM_W - 20) * progress)
    cv2.rectangle(frame, (10, CAM_H - 22), (CAM_W - 10, CAM_H - 8),
                  (40, 40, 40), -1)
    if bar_w > 0:
        cv2.rectangle(frame, (10, CAM_H - 22), (10 + bar_w, CAM_H - 8),
                      (255, 165, 0), -1)
    cv2.putText(frame, "Hold to open Mode Menu",
                (14, CAM_H - 11),
                cv2.FONT_HERSHEY_SIMPLEX, 0.38, (255, 255, 255), 1)

# ─── MENU OVERLAY ─────────────────────────────────────────
def draw_menu_overlay(frame, current_gesture, now):
    """
    Persistent mode selection menu.
    Stays open until a mode is selected or M key / hand-loss closes it.
    Each row highlights when its gesture is detected.
    A small confirm bar fills on the active row — hold 0.6s to select.
    """
    global menu_select_candidate, menu_select_start
    global mode, pre_menu_mode, mode_cooldown
    global rps_state, rps_buf, sos_triggered

    # ── Semi-transparent dark backdrop ────────────────────
    overlay = frame.copy()
    cv2.rectangle(overlay, (0, 0), (CAM_W, CAM_H), (8, 8, 25), -1)
    cv2.addWeighted(overlay, 0.80, frame, 0.20, 0, frame)

    # ── Title bar ─────────────────────────────────────────
    cv2.rectangle(frame, (0, 0), (CAM_W, 48), (20, 20, 50), -1)
    cv2.putText(frame, "SELECT MODE",
                (CAM_W // 2 - 100, 34),
                cv2.FONT_HERSHEY_DUPLEX, 0.9, (255, 165, 0), 2, cv2.LINE_AA)

    # ── Subtitle ──────────────────────────────────────────
    cv2.putText(frame, "Show gesture and hold 0.6s to confirm  |  M = close",
                (14, 62),
                cv2.FONT_HERSHEY_SIMPLEX, 0.36, (160, 160, 160), 1)

    # ── Menu rows ─────────────────────────────────────────
    row_h   = 62
    start_y = 70
    pad     = 10

    selected_mode = None

    for i, (gest, target, hint) in enumerate(MENU_OPTIONS):
        y1 = start_y + i * row_h
        y2 = y1 + row_h - 4

        is_highlighted = (current_gesture == gest)
        mode_color     = MODES[target][1]
        mode_name      = MODES[target][0]

        # Row background
        bg = (28, 48, 28) if is_highlighted else (16, 16, 36)
        cv2.rectangle(frame, (pad, y1), (CAM_W - pad, y2), bg, -1)

        # Left colored accent strip
        strip_color = mode_color if is_highlighted else (55, 55, 55)
        cv2.rectangle(frame, (pad, y1), (pad + 6, y2), strip_color, -1)

        # Gesture description (top line of row)
        cv2.putText(frame, hint,
                    (pad + 14, y1 + 22),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.42,
                    (230, 230, 230) if is_highlighted else (120, 120, 120), 1)

        # Mode name (bottom line of row)
        cv2.putText(frame, f"  {mode_name}",
                    (pad + 14, y1 + 44),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.52,
                    mode_color if is_highlighted else (80, 80, 80),
                    1 if not is_highlighted else 2)

        # Gesture name badge (right side)
        cv2.putText(frame, gest,
                    (CAM_W - 170, y1 + 34),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.38,
                    mode_color if is_highlighted else (70, 70, 70), 1)

        # Highlight border
        if is_highlighted:
            cv2.rectangle(frame, (pad, y1), (CAM_W - pad, y2),
                          mode_color, 2)

        # ── Confirm progress bar (fills at bottom of highlighted row) ──
        if is_highlighted:
            if menu_select_candidate == gest:
                held = now - menu_select_start
                prog = min(held / MENU_SELECT_HOLD, 1.0)
                bar  = int((CAM_W - 2 * pad - 8) * prog)
                # Gray track
                cv2.rectangle(frame,
                              (pad + 7, y2 - 9),
                              (CAM_W - pad - 1, y2 - 3),
                              (50, 50, 50), -1)
                # Colored fill
                if bar > 0:
                    cv2.rectangle(frame,
                                  (pad + 7, y2 - 9),
                                  (pad + 7 + bar, y2 - 3),
                                  mode_color, -1)
                if held >= MENU_SELECT_HOLD:
                    selected_mode = target   # ← confirmed selection
            else:
                # New gesture on this row — start hold timer
                menu_select_candidate = gest
                menu_select_start     = now
        else:
            # Row not highlighted — reset if it was the candidate
            if menu_select_candidate == gest:
                menu_select_candidate = None

    # ── Reminder at bottom ────────────────────────────────
    cv2.putText(frame,
                "THUMBS INDEX = reopen menu from any mode",
                (14, CAM_H - 10),
                cv2.FONT_HERSHEY_SIMPLEX, 0.35, (110, 110, 110), 1)

    # ── Perform switch if a row was confirmed ──────────────
    if selected_mode:
        mode          = selected_mode
        mode_cooldown = now + 1.0
        menu_select_candidate = None
        sos_triggered = False

        if mode == "GAME":
            rps_state = "waiting"
            rps_buf.clear()
            print("Entering Rock Paper Scissors Game!")
        elif mode == "APPLIANCE":
            print("Entering Appliance Control!")
        elif mode == "SOS":
            pass  # trigger_sos() fires next frame

        speak(MODES[mode][0])
        print(f"Mode → {MODES[mode][0]}")

# ─── RPS OVERLAY ──────────────────────────────────────────
FONT = cv2.FONT_HERSHEY_DUPLEX

def shadow_text(img, text, pos, scale, color, thick=2):
    x, y = pos
    cv2.putText(img, text, (x+2, y+2), FONT, scale, (0,0,0),  thick+1, cv2.LINE_AA)
    cv2.putText(img, text, (x,   y  ), FONT, scale, color,    thick,   cv2.LINE_AA)

def pill(img, x1, y1, x2, y2, color, alpha=0.70):
    ov = img.copy()
    cv2.rectangle(ov, (x1, y1), (x2, y2), color, -1, cv2.LINE_AA)
    cv2.addWeighted(ov, alpha, img, 1 - alpha, 0, img)

def draw_rps_overlay(frame, stable_rps_gesture):
    global rps_state, rps_countdown_st, rps_result_st
    global rps_cpu_choice, rps_player_choice, rps_result_text, rps_scores

    W, H = CAM_W, CAM_H
    now  = time.time()

    panel_x = W // 2
    pill(frame, panel_x, 55, W, H - 5, (10, 10, 30), 0.82)

    shadow_text(frame, "RPS GAME", (panel_x + 15, 90), 0.75, (200, 100, 255))
    shadow_text(frame, "FIST=Rock  PEACE=Scissors", (panel_x + 5, 115), 0.38, (180, 180, 180), 1)
    shadow_text(frame, "OPEN PALM=Paper",            (panel_x + 5, 132), 0.38, (180, 180, 180), 1)

    shadow_text(frame,
                f"You:{rps_scores['You']}  Tie:{rps_scores['Tie']}  CPU:{rps_scores['CPU']}",
                (panel_x + 8, 158), 0.50, (130, 255, 130), 1)

    badge_color = (80, 200, 80) if stable_rps_gesture else (100, 100, 100)
    pill(frame, panel_x + 5, 168, W - 5, 198, (20, 20, 50), 0.80)
    label = stable_rps_gesture if stable_rps_gesture else "---"
    shadow_text(frame, f"Gesture: {label}", (panel_x + 10, 190), 0.52, badge_color, 1)

    mid_y = H // 2

    if rps_state == "waiting":
        pill(frame, panel_x + 5, mid_y - 55, W - 5, mid_y + 65, (20, 20, 20), 0.80)
        shadow_text(frame, "Show hand,",      (panel_x + 15, mid_y - 25), 0.65, (210, 210, 210), 1)
        shadow_text(frame, "press SPACE",     (panel_x + 15, mid_y + 10), 0.65, (210, 210, 210), 1)
        shadow_text(frame, "to start round!", (panel_x + 15, mid_y + 42), 0.60, (150, 150, 150), 1)
        shadow_text(frame, "R = reset scores",(panel_x + 15, H - 25),    0.40, (120, 120, 120), 1)

    elif rps_state == "countdown":
        elapsed   = now - rps_countdown_st
        remaining = RPS_COUNTDOWN - elapsed

        if remaining <= 0:
            rps_player_choice = stable_rps_gesture or "Rock"
            rps_cpu_choice    = random.choice(RPS_CHOICES)
            rps_result_text   = rps_get_result(rps_player_choice, rps_cpu_choice)

            if   "Win"  in rps_result_text: rps_scores["You"] += 1
            elif "Lose" in rps_result_text: rps_scores["CPU"] += 1
            else:                           rps_scores["Tie"] += 1

            speak(rps_result_text.split("!")[0])
            rps_state     = "result"
            rps_result_st = now
        else:
            num_str = str(int(remaining) + 1)
            shadow_text(frame, "GET READY", (panel_x + 25, mid_y - 40), 0.75, (255, 220, 50))
            shadow_text(frame, num_str,     (panel_x + 85, mid_y + 55), 2.2,  (0, 220, 255), 4)

            if stable_rps_gesture:
                pill(frame, panel_x + 5, H - 45, W - 5, H - 10, (0, 60, 0), 0.80)
                shadow_text(frame, f"Locked: {stable_rps_gesture}", (panel_x + 10, H - 18), 0.50, (80, 255, 80), 1)
            else:
                pill(frame, panel_x + 5, H - 45, W - 5, H - 10, (60, 0, 0), 0.80)
                shadow_text(frame, "No gesture!", (panel_x + 10, H - 18), 0.50, (100, 100, 255), 1)

    elif rps_state == "result":
        if   "Win"  in rps_result_text: rc = (80, 255, 100)
        elif "Lose" in rps_result_text: rc = (80, 100, 255)
        else:                           rc = (255, 220,  50)

        pill(frame, panel_x + 5, mid_y - 100, W - 5, mid_y + 120, (20, 20, 20), 0.88)
        shadow_text(frame, rps_result_text,             (panel_x + 12, mid_y - 65),  0.68, rc, 2)
        shadow_text(frame, f"You: {rps_player_choice}", (panel_x + 12, mid_y - 20), 0.58, (150, 255, 150), 1)
        shadow_text(frame, f"CPU: {rps_cpu_choice}",    (panel_x + 12, mid_y + 20), 0.58, (150, 150, 255), 1)
        shadow_text(frame, "SPACE to play again",       (panel_x + 12, mid_y + 60), 0.44, (180, 180, 180), 1)

        if now - rps_result_st >= RPS_RESULT_SHOW:
            rps_state = "waiting"
            rps_buf.clear()

# ─── MAIN UI BAR ──────────────────────────────────────────
def draw_ui(frame, gesture, current_mode):
    name, color = MODES[current_mode]
    cv2.rectangle(frame, (0, 0), (CAM_W, 50), (30, 30, 30), -1)
    cv2.putText(frame, f"Mode: {name}", (10, 32),
                cv2.FONT_HERSHEY_SIMPLEX, 0.7, color, 2)
    cv2.putText(frame, f"Gesture: {gesture}", (10, CAM_H - 10),
                cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)
    light_str = "ON" if appliance_states["LIGHT"] else "OFF"
    fan_str   = "ON" if appliance_states["FAN"]   else "OFF"
    cv2.putText(frame, f"Light:{light_str}  Fan:{fan_str}",
                (CAM_W - 220, 32),
                cv2.FONT_HERSHEY_SIMPLEX, 0.55, (200, 200, 200), 1)
    if current_mode != "MENU":
        cv2.putText(frame, "THUMB+INDEX hold = Menu",
                    (10, CAM_H - 30),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.38, (140, 140, 140), 1)

# ─── MAIN LOOP ────────────────────────────────────────────
cap = cv2.VideoCapture(0)
cap.set(cv2.CAP_PROP_FRAME_WIDTH,  CAM_W)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, CAM_H)
cap.set(cv2.CAP_PROP_FPS, 30)

print("GestureFlow started. Press Q to quit.")
print()
print("── Open Mode Menu ───────────────────────────────────")
print("Hold THUMBS_INDEX (thumb + index up) for 1 second")
print("Menu stays open until you select a mode or press M")
print()
print("── Menu gestures ────────────────────────────────────")
print("OPEN_PALM  -> Virtual Mouse")
print("PEACE      -> Media Control")
print("THUMB_ONLY -> Appliance Control")
print("FIST       -> RPS Game")
print("SPIDERMAN  -> SOS")
print("POINTING   -> Idle")

while True:
    ret, frame = cap.read()
    if not ret:
        break

    frame   = cv2.flip(frame, 1)
    rgb     = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    results = hands.process(rgb)
    gesture = "NONE"
    now     = time.time()

    raw_rps_gesture    = None
    stable_rps_gesture = None

    if results.multi_hand_landmarks:
        hand_lms = results.multi_hand_landmarks[0]
        mp_draw.draw_landmarks(frame, hand_lms, mp_hands.HAND_CONNECTIONS)
        lm      = get_landmarks(hand_lms, CAM_W, CAM_H)
        gesture = recognizer.recognize(lm)

        menu_no_hand_since = 0.0   # hand is present — reset loss timer

        # ══════════════════════════════════════════════════
        # MENU MODE — all gestures go to menu selection
        # ══════════════════════════════════════════════════
        if mode == "MENU":
            draw_menu_overlay(frame, gesture, now)
            # mode may have changed inside draw_menu_overlay if confirmed

        else:
            # ── THUMBS_INDEX hold → open menu ─────────────
            if gesture == "THUMBS_INDEX":
                if trigger_hold_start == 0.0:
                    trigger_hold_start = now
                else:
                    held     = now - trigger_hold_start
                    progress = min(held / MENU_TRIGGER_HOLD, 1.0)
                    draw_trigger_bar(frame, progress)

                    if held >= MENU_TRIGGER_HOLD:
                        pre_menu_mode         = mode
                        mode                  = "MENU"
                        trigger_hold_start    = 0.0
                        menu_select_candidate = None
                        menu_no_hand_since    = 0.0
                        speak("Select mode")
                        print("Menu opened.")
            else:
                trigger_hold_start = 0.0   # reset if gesture changes

            # ── Virtual Mouse ─────────────────────────────
            if mode == "MOUSE":
                ix, iy = lm[8]
                tx = np.interp(ix, [FRAME_REDUCTION, CAM_W - FRAME_REDUCTION], [0, SCREEN_W])
                ty = np.interp(iy, [FRAME_REDUCTION, CAM_H - FRAME_REDUCTION], [0, SCREEN_H])
                smooth_x.append(tx); smooth_x.pop(0)
                smooth_y.append(ty); smooth_y.pop(0)
                sx = int(sum(smooth_x) / SMOOTH)
                sy = int(sum(smooth_y) / SMOOTH)
                mouse.position = (sx, sy)

                if gesture == "PINCH" and now > click_cooldown:
                    mouse.click(Button.left)
                    click_cooldown = now + 0.4
                if gesture == "TWO_PINCH" and now > click_cooldown:
                    mouse.click(Button.right)
                    click_cooldown = now + 0.6

                cv2.circle(frame, (ix, iy), 10, (255, 200, 0), cv2.FILLED)

            # ── Media Control ─────────────────────────────
            elif mode == "MEDIA" and now > gesture_lock:
                if gesture == "OPEN_PALM":
                    keyboard.press(Key.media_play_pause)
                    keyboard.release(Key.media_play_pause)
                    gesture_lock = now + 0.8
                    speak("play pause")
                elif gesture == "PINKY":
                    keyboard.press(Key.media_next)
                    keyboard.release(Key.media_next)
                    gesture_lock = now + 0.8
                    speak("next")
                elif gesture == "THUMB_ONLY":
                    keyboard.press(Key.media_previous)
                    keyboard.release(Key.media_previous)
                    gesture_lock = now + 0.8
                    speak("previous")
                elif gesture == "POINTING":
                    keyboard.press(Key.media_volume_up)
                    keyboard.release(Key.media_volume_up)
                    gesture_lock = now + 0.3
                elif gesture == "FIST":
                    keyboard.press(Key.media_volume_down)
                    keyboard.release(Key.media_volume_down)
                    gesture_lock = now + 0.3

            # ── Appliance Control ─────────────────────────
            elif mode == "APPLIANCE" and now > gesture_lock:
                if gesture == "POINTING":
                    toggle_appliance("LIGHT")
                    gesture_lock = now + 1.0
                elif gesture == "PINKY":
                    toggle_appliance("FAN")
                    gesture_lock = now + 1.0

            # ── Emergency SOS ─────────────────────────────
            elif mode == "SOS":
                trigger_sos()
                cv2.rectangle(frame, (0, 0), (CAM_W, CAM_H), (0, 0, 255), 8)

            raw_rps_gesture = RPS_GESTURE_MAP.get(gesture)

    else:
        # ── No hand detected ──────────────────────────────
        trigger_hold_start    = 0.0
        menu_select_candidate = None

        if mode == "MENU":
            # Close menu after 3s of no hand
            if menu_no_hand_since == 0.0:
                menu_no_hand_since = now
            elif now - menu_no_hand_since >= 3.0:
                mode               = pre_menu_mode
                menu_no_hand_since = 0.0
                print("Menu closed — no hand detected.")
        else:
            menu_no_hand_since = 0.0
            if mode not in ("IDLE", "GAME", "APPLIANCE") and now > mode_cooldown + 3:
                mode = "IDLE"

    # ── RPS Gesture Smoothing ──────────────────────────────
    if mode == "GAME":
        if raw_rps_gesture:
            rps_buf.append(raw_rps_gesture)
        if len(rps_buf) > RPS_BUF:
            rps_buf.pop(0)

        if rps_buf:
            top, freq = Counter(rps_buf).most_common(1)[0]
            if freq / len(rps_buf) >= RPS_CONF:
                stable_rps_gesture = top

        draw_rps_overlay(frame, stable_rps_gesture)

    # ── Main UI bar ───────────────────────────────────────
    draw_ui(frame, gesture, mode)

    cv2.imshow("GestureFlow", frame)

    key = cv2.waitKey(1) & 0xFF

    if key == ord('q'):
        break

    # M key — close menu and return to previous mode
    if key == ord('m') and mode == "MENU":
        mode                  = pre_menu_mode
        menu_select_candidate = None
        print("Menu closed.")

    # RPS keyboard controls
    if mode == "GAME":
        if key == ord(' '):
            if rps_state == "waiting":
                rps_state        = "countdown"
                rps_countdown_st = time.time()
                rps_buf.clear()
            elif rps_state == "result":
                rps_state = "waiting"
                rps_buf.clear()
        elif key == ord('r'):
            rps_scores = {"You": 0, "CPU": 0, "Tie": 0}
            rps_state  = "waiting"
            rps_buf.clear()
        elif key == ord('e'):
            mode          = "IDLE"
            mode_cooldown = time.time() + 1.0
            rps_state     = "waiting"
            rps_buf.clear()
            print("Exited Rock Paper Scissors Game.")

cap.release()
cv2.destroyAllWindows()
print("GestureFlow stopped.")
print(f"Final RPS Scores -> You: {rps_scores['You']}  |  Tie: {rps_scores['Tie']}  |  CPU: {rps_scores['CPU']}")

