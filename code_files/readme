#virtuall_mousee.py
import cv2
import pyautogui
import mediapipe as mp
from mediapipe.tasks import python as mp_python
from mediapipe.tasks.python import vision
from mediapipe.tasks.python.vision import HandLandmarkerOptions
import urllib.request
import math
import time
import os

pyautogui.FAILSAFE = False

SMOOTHING        = 5
SENSITIVITY      = 1.2

# --- Click tuning ---
PINCH_CLICK_DIST    = 40    # pixels (on 640x480 frame) — thumb & index must be closer than this to click
PINCH_RELEASE_DIST  = 55    # pixels — must open wider than this before next click is allowed
CLICK_COOLDOWN      = 0.35  # seconds between clicks (prevents rapid-fire)

# Download model file on first run (~9 MB)
MODEL_PATH = "hand_landmarker.task"
MODEL_URL  = "https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/latest/hand_landmarker.task"

if not os.path.exists(MODEL_PATH):
    print("Downloading hand model (~9 MB, one time only)...")
    urllib.request.urlretrieve(MODEL_URL, MODEL_PATH)
    print("Download done!")

# Setup hand landmarker
base_options = mp_python.BaseOptions(model_asset_path=MODEL_PATH)
options = HandLandmarkerOptions(
    base_options=base_options,
    num_hands=1,
    min_hand_detection_confidence=0.7,
    min_hand_presence_confidence=0.7,
    min_tracking_confidence=0.7,
    running_mode=vision.RunningMode.IMAGE,
)
landmarker = vision.HandLandmarker.create_from_options(options)

HAND_CONNECTIONS = [
    (0,1),(1,2),(2,3),(3,4),
    (0,5),(5,6),(6,7),(7,8),
    (0,9),(9,10),(10,11),(11,12),
    (0,13),(13,14),(14,15),(15,16),
    (0,17),(17,18),(18,19),(19,20),
    (5,9),(9,13),(13,17),
]

cap = cv2.VideoCapture(0)
cap.set(cv2.CAP_PROP_FRAME_WIDTH,  640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

screen_w, screen_h = pyautogui.size()
prev_x_list = []
prev_y_list = []

# Click state
pinch_active   = False   # True while thumb+index are pinched
last_click_time = 0.0

print("Virtual Mouse started!")
print("  Move  → point with index finger")
print("  Click → pinch thumb + index finger together")
print("  Press Q to quit.")

while True:
    ok, frame = cap.read()
    if not ok:
        print("Cannot read webcam.")
        break

    frame = cv2.flip(frame, 1)
    frame_h, frame_w, _ = frame.shape

    rgb    = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    mp_img = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb)
    result = landmarker.detect(mp_img)

    if result.hand_landmarks:
        landmarks = result.hand_landmarks[0]

        # Draw skeleton
        for a, b in HAND_CONNECTIONS:
            x1 = int(landmarks[a].x * frame_w)
            y1 = int(landmarks[a].y * frame_h)
            x2 = int(landmarks[b].x * frame_w)
            y2 = int(landmarks[b].y * frame_h)
            cv2.line(frame, (x1, y1), (x2, y2), (0, 200, 255), 2)

        for lm in landmarks:
            cx = int(lm.x * frame_w)
            cy = int(lm.y * frame_h)
            cv2.circle(frame, (cx, cy), 4, (255, 255, 255), cv2.FILLED)

        # Landmark 8 = index tip, landmark 4 = thumb tip
        index_tip = landmarks[8]
        thumb_tip  = landmarks[4]

        finger_x = int(index_tip.x * frame_w)
        finger_y = int(index_tip.y * frame_h)
        thumb_x  = int(thumb_tip.x  * frame_w)
        thumb_y  = int(thumb_tip.y  * frame_h)

        # Euclidean distance between thumb and index tip (in frame pixels)
        pinch_dist = math.hypot(finger_x - thumb_x, finger_y - thumb_y)

        # ── Click logic ──────────────────────────────────────────────
        now = time.time()
        if pinch_dist < PINCH_CLICK_DIST and not pinch_active:
            if now - last_click_time > CLICK_COOLDOWN:
                pyautogui.click()
                last_click_time = now
                pinch_active = True
                print(f"[CLICK] pinch_dist={pinch_dist:.1f}px")
        elif pinch_dist > PINCH_RELEASE_DIST:
            pinch_active = False          # reset so next pinch can fire
        # ─────────────────────────────────────────────────────────────

        # Visual feedback
        dot_color = (0, 0, 255) if pinch_active else (0, 255, 0)
        cv2.circle(frame, (finger_x, finger_y), 12, dot_color, cv2.FILLED)
        cv2.circle(frame, (finger_x, finger_y), 12, (255, 255, 255), 2)
        cv2.circle(frame, (thumb_x,  thumb_y),  10, dot_color, cv2.FILLED)
        cv2.circle(frame, (thumb_x,  thumb_y),  10, (255, 255, 255), 2)
        # Line between thumb and index shows pinch proximity
        line_color = (0, 0, 255) if pinch_active else (200, 200, 200)
        cv2.line(frame, (thumb_x, thumb_y), (finger_x, finger_y), line_color, 2)

        # Map index tip → screen coordinates
        target_x = int(index_tip.x * screen_w * SENSITIVITY)
        target_y = int(index_tip.y * screen_h * SENSITIVITY)
        target_x = max(0, min(screen_w - 1, target_x))
        target_y = max(0, min(screen_h - 1, target_y))

        # Smooth
        prev_x_list.append(target_x)
        prev_y_list.append(target_y)
        if len(prev_x_list) > SMOOTHING:
            prev_x_list.pop(0)
            prev_y_list.pop(0)

        smooth_x = int(sum(prev_x_list) / len(prev_x_list))
        smooth_y = int(sum(prev_y_list) / len(prev_y_list))

        pyautogui.moveTo(smooth_x, smooth_y)

        status = "CLICKING" if pinch_active else "moving"
        cv2.putText(frame, f"{status}  cursor:({smooth_x},{smooth_y})",
                    (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.65, dot_color, 2)
        cv2.putText(frame, f"pinch dist: {pinch_dist:.0f}px",
                    (10, 58), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (200, 200, 200), 1)

    else:
        prev_x_list.clear()
        prev_y_list.clear()
        pinch_active = False
        cv2.putText(frame, "No hand detected",
                    (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)

    cv2.imshow("Virtual Mouse  |  Q to quit", frame)
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
landmarker.close()
print("Stopped.")

